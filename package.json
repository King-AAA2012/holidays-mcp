    "public-holiday"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "holidays-mcp": "./server.js"
  },
  "files": [
    "server.js",
    "lib"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
